# Copy this file to .env and fill in real values for your machine.
# Never commit the real .env file.

# --- App ---
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sitewell

# --- Redis / background jobs ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Crawler (used only for URL validation in this step; no fetching yet) ---
CRAWLER_USER_AGENT=SitewellBot/0.1 (+https://example.com/bot)
CRAWLER_MAX_PAGES_PER_SCAN=10
CRAWLER_TIMEOUT_SECONDS=15

# --- Not used yet (reserved for later steps, listed here so the eventual
# additions are obvious from this file's shape; do not fill in early) ---
# JWT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# ANTHROPIC_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SENTRY_DSN=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
